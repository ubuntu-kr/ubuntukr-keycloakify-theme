{
    "name": "ubuntukr-keycloakify-theme",
    "homepage": "https://github.com/ubuntu-kr/ubuntukr-keycloakify-theme",
    "version": "0.1.0",
    "description": "Keycloak theme for Ubuntu Korea",
    "repository": {
        "type": "git",
        "url": "git://github.com/ubuntu-kr/ubuntukr-keycloakify-theme.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && PATH=\"$PWD/scripts/no-maven:$PATH\" keycloakify build",
        "build-account-theme": "node account-console-theme/build-jar.mjs",
        "build-all": "npm run build-keycloak-theme && npm run build-account-theme"
    },
    "author": "Ubuntu Korea Community",
    "license": "MIT",
    "keywords": [],
    "dependencies": {
        "@canonical/react-components": "0.42.0",
        "keycloakify": "^11.16.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^9.1.0",
        "vanilla-framework": "4.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "sass": "~1.63.6",
        "typescript": "^5.2.2",
        "vite": "^5.4.0"
    },
    "overrides": {
        "@canonical/react-components": {
            "vanilla-framework": "$vanilla-framework",
            "@types/react": "$@types/react",
            "@types/react-dom": "$@types/react-dom"
        }
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    }
}
